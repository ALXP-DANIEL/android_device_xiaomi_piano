<?xml version="1.0" encoding="utf-8"?>
<!-- China OS3.0.307.0.WPYCNXM AospFrameworkResOverlay.apk values.
     Keep automatic brightness and sensor-dependent tuning for later validation. -->
<resources>
    <bool name="config_showNavigationBar">true</bool>
    <bool name="config_voice_capable">false</bool>
    <item name="config_screenBrightnessDimFloat" format="float" type="dimen">0.00170982</item>
    <item name="config_screenBrightnessSettingMinimumFloat" format="float" type="dimen">0.00170982</item>
    <item name="config_screenBrightnessSettingMaximumFloat" format="float" type="dimen">1.0</item>
    <item name="config_screenBrightnessSettingDefaultFloat" format="float" type="dimen">0.0747435</item>

    <!-- Tablet: let the lock screen follow the device orientation. -->
    <bool name="config_enableLockScreenRotation">true</bool>

    <!-- The smart cover's hall sensor reports SW_LID: sleep when it closes,
         wake when it opens. -->
    <bool name="config_lidControlsSleep">true</bool>

    <!-- QDCM provides native, sRGB and Display P3: offer natural, boosted,
         saturated and automatic, like the stock color scheme options. -->
    <integer-array name="config_availableColorModes">
        <item>0</item>
        <item>1</item>
        <item>2</item>
        <item>3</item>
    </integer-array>
</resources>
