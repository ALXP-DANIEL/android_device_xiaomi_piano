<?xml version="1.0" encoding="utf-8"?>
<!-- SPDX-License-Identifier: Apache-2.0 -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.lineageos.pianoparts"
    android:sharedUserId="android.uid.system">

    <uses-permission android:name="android.permission.INTERNAL_SYSTEM_WINDOW" />

    <application
        android:name=".PianoPartsApp"
        android:label="@string/app_name"
        android:persistent="true"
        android:directBootAware="true">

        <service
            android:name=".ThermalProfileTileService"
            android:icon="@drawable/ic_thermal_tile"
            android:label="@string/thermal_profile_title"
            android:exported="true"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".TouchGameModeTileService"
            android:icon="@drawable/ic_touch_tile"
            android:label="@string/touch_game_mode_title"
            android:exported="true"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".ReadingModeTileService"
            android:icon="@drawable/ic_reading_tile"
            android:label="@string/reading_mode_title"
            android:exported="true"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".SunlightModeTileService"
            android:icon="@drawable/ic_sunlight_tile"
            android:label="@string/sunlight_mode_title"
            android:exported="true"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".TrueToneTileService"
            android:icon="@drawable/ic_true_tone_tile"
            android:label="@string/true_tone_title"
            android:exported="true"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".BypassChargingTileService"
            android:icon="@drawable/ic_bypass_tile"
            android:label="@string/bypass_charging_title"
            android:exported="true"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>
</manifest>
