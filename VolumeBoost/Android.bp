android_app {
    name: "PianoVolumeBoost",
    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],
    certificate: "platform",
    platform_apis: true,
    privileged: true,
    system_ext_specific: true,
    required: ["privapp-permissions-piano-volumeboost"],
}

prebuilt_etc {
    name: "privapp-permissions-piano-volumeboost",
    src: "privapp-permissions-piano-volumeboost.xml",
    filename_from_src: true,
    sub_dir: "permissions",
    system_ext_specific: true,
}
