# Initial piano touch policy, scoped to selected stock services and paths.
hal_attribute(piano_touch)
type piano_touch_default, domain;
type piano_touch_default_exec, exec_type, vendor_file_type, file_type;
type piano_touch_service, hal_service_type, protected_service, service_manager_type;
type piano_touch_device, dev_type;
type piano_touch_sysfs, fs_type, sysfs_type;
type piano_touch_data_file, file_type, data_file_type;
type piano_touch_persist_file, file_type;
init_daemon_domain(piano_touch_default)
hal_server_domain(piano_touch_default, hal_piano_touch)
binder_use(piano_touch_default)
hal_attribute_service(hal_piano_touch, piano_touch_service)
allow piano_touch_default piano_touch_device:chr_file rw_file_perms;
allow piano_touch_default self:capability sys_nice;
r_dir_file(piano_touch_default, piano_touch_sysfs)
allow piano_touch_default piano_touch_sysfs:file rw_file_perms;
allow piano_touch_default input_device:dir r_dir_perms;
allow piano_touch_default input_device:chr_file rw_file_perms;
allow piano_touch_default piano_touch_data_file:dir create_dir_perms;
allow piano_touch_default piano_touch_data_file:file create_file_perms;
allow piano_touch_default piano_touch_persist_file:dir create_dir_perms;
allow piano_touch_default piano_touch_persist_file:file create_file_perms;
set_prop(piano_touch_default, vendor_piano_touch_prop)

# Stock one-shot touch event helper.
type piano_tpevent, domain;
type piano_tpevent_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(piano_tpevent)
allow piano_tpevent input_device:dir r_dir_perms;
allow piano_tpevent input_device:chr_file rw_file_perms;
allow piano_tpevent piano_touch_device:chr_file rw_file_perms;
r_dir_file(piano_tpevent, piano_touch_sysfs)
allow piano_tpevent piano_touch_sysfs:file rw_file_perms;
allow piano_tpevent proc_interrupts:file r_file_perms;

# Explicit label used by stock panel-info-sh init stanza.
type vendor_touch_init_shell, domain;
type vendor_touch_init_shell_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(vendor_touch_init_shell)
allow vendor_touch_init_shell vendor_shell_exec:file { entrypoint rx_file_perms };
allow vendor_touch_init_shell vendor_toolbox_exec:file rx_file_perms;
allow vendor_touch_init_shell vendor_configs_file:file r_file_perms;
r_dir_file(vendor_touch_init_shell, piano_touch_sysfs)
set_prop(vendor_touch_init_shell, vendor_piano_panel_prop)
allow vendor_init piano_touch_sysfs:file setattr;
allow vendor_init piano_touch_data_file:dir create_dir_perms;
allow vendor_init piano_touch_persist_file:dir create_dir_perms;
