# Stock/donor charging paths; no permissions for unrelated sysfs nodes.
genfscon sysfs /devices/virtual/xm_power u:object_r:vendor_sysfs_xm_power:s0
genfscon sysfs /devices/platform/soc/soc:smart_charge u:object_r:vendor_sysfs_qcom_battery:s0

genfscon sysfs /devices/virtual/touch/touch_dev u:object_r:piano_touch_sysfs:s0
