# PianoParts runs as system_app: it sends the screen rotation to TouchFeature
# switches the mi_thermald profile and the DisplayFeature reading mode.
hal_client_domain(system_app, hal_touchfeature_xiaomi)
binder_call(system_app, hal_touchfeature_xiaomi_default)
allow system_app sysfs_thermal:dir search;
allow system_app sysfs_thermal:file rw_file_perms;
hal_client_domain(system_app, vendor_hal_displayfeature_xiaomi)
# Pen battery popup: read the charger's REVERSE_PEN_SOC uevents.
allow system_app self:netlink_kobject_uevent_socket { create bind read setopt getopt };
# Bypass charging tile: the smart_chg node.
allow system_app vendor_sysfs_qcom_battery:dir search;
allow system_app vendor_sysfs_qcom_battery:file rw_file_perms;
# Keyboard tiles: send feature commands to the keyboard nanoapp HAL.
allow system_app hal_keyboardnanoapp_service:service_manager find;
binder_call(system_app, nanoapp_aidl)
